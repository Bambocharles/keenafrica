generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  draft
  active
  paused
}

enum MembershipRole {
  sponsor_admin
  beneficiary
}

enum UserStatus {
  active
  suspended
}

// Education Core (Session 04).
enum CourseStatus {
  draft
  published
  archived
}

enum ContentStatus {
  draft
  published
  archived
}

enum CohortStatus {
  active
  archived
}

enum EnrollmentStatus {
  active
  completed
  withdrawn
}

enum ResourceType {
  link
  document
  video
}

// Session 06 (Student).
enum NoteTargetType {
  course
  module
  lesson
  resource
  question
}

enum BookmarkTargetType {
  lesson
  resource
}

// Session 07 (Assessment).
enum QuestionType {
  single_choice
  multiple_choice
  short_answer
}

enum QuestionDifficulty {
  easy
  medium
  hard
}

enum AssessmentStatus {
  draft
  published
  archived
}

enum AssessmentAssignmentScope {
  cohort
  student
}

enum AttemptStatus {
  in_progress
  submitted
  graded
}

// Session 08 (Progress & Adaptive Learning). No status enum — a row's mere
// existence IS the evidence (a student completed this lesson); see
// LessonProgress's own comment for why there's no "in_progress" state.

// Session 13 (Files & Content Assets). Canonical Asset/File service —
// storage-vendor-agnostic (see src/lib/storage.ts): Postgres only ever
// stores metadata, never binary content. AssetAttachment is a generic,
// polymorphic join (the same targetType/targetId shape as
// NoteTargetType/BookmarkTargetType above) so Messaging/Sponsor/
// Certificates (Sessions 09/11/14) attach to the same Asset table by adding
// their own AssetEntityType value + a matching case in
// src/lib/assets.ts's visibility resolver, instead of building a parallel
// TeacherFiles/StudentFiles/SponsorFiles system. Only "lesson_resource"
// exists today — the one real, wired consumer (Resource, Session 04).
enum AssetStatus {
  active
  deleted
}

// 'message' added by Session 09 (Messaging) — see that section below and
// docs/ASSETS.md's "Extending this for a new consumer" walkthrough. Added
// in a separate migration from the Message/Conversation tables themselves:
// Postgres cannot use a new enum value in the same transaction that adds
// it, so the asset_attachments RLS branch referencing 'message' had to
// land as its own follow-up migration.
//
// 'sponsor_document' added by Session 11 (Sponsor) — same reasoning, same
// split-migration requirement. Anchor row is ProjectDocument (see Sponsor
// Core section below), mirroring Resource's role for 'lesson_resource'.
//
// 'certificate' added by Session 14 (Certificates) — same split-migration
// requirement again. Anchor row is Certificate (see Certificates section
// below); like 'message', a Certificate has no direct asset_id column —
// the downloadable file is purely an AssetAttachment join, generated once
// at issuance time (src/lib/certificates.ts's attachDownloadableCertificate).
enum AssetEntityType {
  lesson_resource
  message
  sponsor_document
  certificate
}

// Session 10 (Notifications). event-to-notification mapping — see
// schema.prisma's "Notifications (Session 10)" section below and
// docs/NOTIFICATIONS.md for the full contract and which domain event
// produces which type.
enum NotificationType {
  message_received
  assessment_assigned
  assessment_submitted
  assessment_graded
  course_published
  student_enrolled
  certificate_issued
  account_suspended
  role_changed
  project_milestone_updated
}

// --- Organization Core (Session 17) --------------------------------------
// A fourth pillar alongside Platform/Education/Sponsor Core
// (PLATFORM_ARCHITECTURE.md §14): a general membership/tenant boundary for
// teachers/students (school, church, company, NGO, training center, or an
// individual's personal B2C space) — deliberately separate from Sponsor
// (a funding/project relationship, unrelated concept, never merged).
//
// User -> OrganizationMembership -> Organization is the only relationship
// path; organizationId is NEVER added to User (PLATFORM_CONTEXT.md's
// Organization/Tenant model rule — a person may belong to zero, one, or
// many organizations).
//
// Global roles (src/lib/authz.ts's Role/Permission) answer "what can this
// person do on Keen Africa"; OrganizationMembership.role answers "what can
// this person do inside THIS organization" — two different questions, never
// collapsed into one enum, same separation Sponsor Core already draws
// between the global SPONSOR_ADMIN/SPONSOR_USER Role and
// ProjectMembership.role='sponsor_admin'.
//
// Membership is always gated — either an OrganizationInvitation (email,
// works before the invitee even has an account — Session 18 links it at
// registration) or a self-service join request that starts at status
// 'pending' and requires an org_admin's approval. Nobody can grant
// themselves 'active' membership by supplying an organization id/name from
// the client — see src/lib/organizations.ts and the migration's RLS policy
// comments for the exact enforcement.
//
// See docs/ORGANIZATION_CORE.md for the full contract.

enum OrganizationType {
  school
  church
  company
  ngo
  training_center
  government
  university
  community
  personal
  other
}

enum OrganizationStatus {
  pending
  active
  suspended
  archived
}

enum OrganizationMembershipRole {
  org_admin
  org_member
}

// INVITED: an org_admin added a known existing user directly, awaiting
// their acceptance. PENDING: the user requested to join, awaiting an
// org_admin's approval. ACTIVE: full member. SUSPENDED: temporarily
// blocked, never deleted. REMOVED: no longer a member (rejected join
// request, admin removal, or self-service "leave") — kept for history
// rather than deleted, same "lifecycle states over destructive delete"
// convention as User.status/Session.revokedAt.
enum OrganizationMembershipStatus {
  invited
  pending
  active
  suspended
  removed
}

enum OrganizationInvitationStatus {
  pending
  accepted
  revoked
  expired
}

// status defaults to 'active' (not 'pending') — a self-service-created
// organization (Session 18) must be immediately usable by its creator, same
// as a B2C individual account. `verifiedAt` is the separate, optional
// platform-verification signal (PLATFORM_DATA_MODEL.md lists status and
// verification as distinct fields) — an org_admin's own reach into their
// org never depends on it; only future features that specifically require
// verification would gate on it.
model Organization {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String             @unique
  type         OrganizationType   @default(other)
  status       OrganizationStatus @default(active)
  verifiedAt   DateTime?          @map("verified_at") @db.Timestamptz(6)
  description  String?
  logoUrl      String?            @map("logo_url")
  contactEmail String?            @map("contact_email")
  contactPhone String?            @map("contact_phone")
  createdBy    String             @map("created_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator     User                      @relation("OrganizationCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]

  @@index([createdBy])
  @@map("organizations")
}

// The ONLY path from User to Organization — see this section's header
// comment. @@unique([organizationId, userId]) means a user has at most one
// membership row per organization; its `status`/`role` carry the full
// lifecycle rather than deleting and recreating the row.
model OrganizationMembership {
  id             String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                        @map("organization_id") @db.Uuid
  userId         String                        @map("user_id") @db.Uuid
  role           OrganizationMembershipRole    @default(org_member)
  status         OrganizationMembershipStatus  @default(invited)
  invitedBy      String?                       @map("invited_by") @db.Uuid
  joinedAt       DateTime?                     @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         User         @relation("OrganizationMembershipUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inviter      User?        @relation("OrganizationMembershipInviter", fields: [invitedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

// Email-based invitation — works even before the invitee has a platform
// account (Session 18 links it at registration completion). tokenHash-only
// at rest, same single-use/hashed-at-rest shape as PasswordResetToken; the
// raw token is returned once, by src/lib/organizations.ts's
// inviteToOrganization, and never persisted.
model OrganizationInvitation {
  id             String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                        @map("organization_id") @db.Uuid
  email          String                        @db.Citext
  role           OrganizationMembershipRole    @default(org_member)
  tokenHash      String                        @unique @map("token_hash")
  status         OrganizationInvitationStatus  @default(pending)
  invitedBy      String                        @map("invited_by") @db.Uuid
  expiresAt      DateTime                      @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?                     @map("accepted_at") @db.Timestamptz(6)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inviter      User         @relation("OrganizationInvitationInviter", fields: [invitedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId])
  @@index([email])
  @@map("organization_invitations")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique @db.Citext
  passwordHash String     @map("password_hash")
  name         String
  isSuperAdmin Boolean    @default(false) @map("is_super_admin")
  status       UserStatus @default(active)
  suspendedAt  DateTime?  @map("suspended_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships              ProjectMembership[]
  projectDocumentsUploaded ProjectDocument[]
  userRoles                UserRole[]
  sessions                 Session[]
  passwordResetTokens      PasswordResetToken[]
  auditEventsAsActor       AuditEvent[]         @relation("AuditActor")

  coursesCreated          Course[]        @relation("CourseCreator")
  cohortTeaching          CohortTeacher[]
  enrollments             Enrollment[]
  lessonVersionsPublished LessonVersion[]
  resourcesCreated        Resource[]
  studentNotes            StudentNote[]
  bookmarks               Bookmark[]

  assetsUploaded       Asset[]
  assetAttachmentsMade AssetAttachment[]

  conversationsCreated       Conversation[]            @relation("ConversationCreator")
  conversationParticipations ConversationParticipant[]
  messagesSent               Message[]                 @relation("MessageSender")

  questionsCreated               Question[]
  assessmentsCreated             Assessment[]           @relation("AssessmentCreator")
  assessmentVersionsPublished    AssessmentVersion[]    @relation("AssessmentVersionPublisher")
  assessmentAssignmentsCreated   AssessmentAssignment[] @relation("AssessmentAssignmentCreator")
  assessmentAssignmentsAsStudent AssessmentAssignment[] @relation("AssessmentAssignmentStudent")
  attemptsAsStudent              Attempt[]              @relation("AttemptStudent")
  attemptsGraded                 Attempt[]              @relation("AttemptGrader")

  lessonProgress LessonProgress[]

  notificationsReceived Notification[]

  certificatesAsStudent Certificate[] @relation("CertificateStudent")
  certificatesRevoked   Certificate[] @relation("CertificateRevoker")

  organizationsCreated           Organization[]             @relation("OrganizationCreator")
  organizationMemberships        OrganizationMembership[]   @relation("OrganizationMembershipUser")
  organizationMembershipsInvited OrganizationMembership[]    @relation("OrganizationMembershipInviter")
  organizationInvitationsSent    OrganizationInvitation[]    @relation("OrganizationInvitationInviter")

  @@map("users")
}

// Identity/authorization foundation (Session 02). Additive to the existing
// isSuperAdmin flag, not a replacement: isSuperAdmin remains the RLS bypass
// baked into every table's policies (see rls.ts); Role/Permission add
// finer-grained, least-privilege capability for non-super-admin actors.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

// What a role CAN do. Deliberately writable by super-admin only (see
// migration RLS comment) — a role holding `roles.manage` may assign
// existing roles to users, but may not redefine what any role means. That
// distinction blocks a straightforward privilege-escalation path.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Which role(s) a user holds. Many-to-many — a user can be e.g. both
// TEACHER and SPONSOR_USER.
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, roleId])
  @@map("user_roles")
}

// DB-backed session record, checked on every request (see src/lib/sessions.ts
// and the jwt callback in src/lib/auth.ts). This is what makes JWT-strategy
// sessions actually revocable: the JWT only ever carries this row's id: the
// row itself is the source of truth for whether the session is still valid.
model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy String?   @map("revoked_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@map("sessions")
}

// Single-use, time-limited, hashed-at-rest password reset tokens. The raw
// token is returned once (to whatever calls requestPasswordReset) and never
// stored — only its SHA-256 hash is persisted, so a DB read can never
// recover a usable token.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Append-only. No UPDATE/DELETE RLS policy exists for this table at all —
// see the migration — so ordinary application code cannot alter or remove
// an audit record, only insert new ones.
model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_events")
}

model Sponsor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  projects Project[]

  @@map("sponsors")
}

model Project {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sponsorId   String        @map("sponsor_id") @db.Uuid
  name        String
  slug        String        @unique
  // description/startDate/endDate added by Session 11, per
  // PLATFORM_DATA_MODEL.md's Project contract ("description", "dates") —
  // the Phase-1 scaffold only had name/slug/status.
  description String?
  startDate   DateTime?     @map("start_date") @db.Timestamptz(6)
  endDate     DateTime?     @map("end_date") @db.Timestamptz(6)
  status      ProjectStatus @default(active)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sponsor     Sponsor             @relation(fields: [sponsorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberships ProjectMembership[]
  milestones  Milestone[]
  metrics     ProjectMetric[]
  documents   ProjectDocument[]

  @@map("projects")
}

model FeatureFlag {
  key         String   @id
  description String
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

// role='sponsor_admin' means "this user is on the sponsor-side project
// team" (the ownership/relationship row Session 11 scopes sponsor-portal
// access through, mirroring cohort_teachers for Education Core) — it is
// orthogonal to the global SPONSOR_ADMIN/SPONSOR_USER Role a user holds
// (src/lib/authz.ts). The global Role controls CAPABILITY (SPONSOR_ADMIN
// can manage other sponsor users via sponsor.users.manage; SPONSOR_USER is
// read-only); this row's role='sponsor_admin' controls WHICH projects a
// sponsor-side user can see at all, regardless of their global Role. Both
// a SPONSOR_ADMIN and a SPONSOR_USER need a role='sponsor_admin' row here
// to see a given project — the enum value name predates Session 11's
// Role/Permission-based rebuild and is kept as-is per "extend, don't
// replace the Phase-1 scaffold."
model ProjectMembership {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, projectId])
  @@map("project_memberships")
}

// --- Education Core (Session 04) ---------------------------------------
// Course -> Cohort -> Teacher(s) + Students
// Course -> Modules -> Lessons -> Resources
// See docs/EDUCATION_CORE.md for the full ownership/visibility model and
// the RLS policies in this migration's SQL.

model Course {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String       @default("")
  status      CourseStatus @default(draft)
  createdBy   String       @map("created_by") @db.Uuid
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator               User                   @relation("CourseCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cohorts               Cohort[]
  modules               Module[]
  lessons               Lesson[]
  studentNotes          StudentNote[]
  bookmarks             Bookmark[]
  questions             Question[]
  assessments           Assessment[]
  assessmentAssignments AssessmentAssignment[]
  lessonProgress        LessonProgress[]
  certificates          Certificate[]

  @@index([createdBy])
  @@map("courses")
}

model Cohort {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String       @map("course_id") @db.Uuid
  name      String
  status    CohortStatus @default(active)
  startsAt  DateTime?    @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime?    @map("ends_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course                 Course                 @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teachers               CohortTeacher[]
  enrollments            Enrollment[]
  assessmentAssignments  AssessmentAssignment[]
  broadcastConversations Conversation[]

  @@index([courseId])
  @@map("cohorts")
}

// Many-to-many: a cohort can have multiple teachers, a teacher can teach
// multiple cohorts. This — not a direct Course->Teacher link — is the
// ownership boundary every content-authorization check in src/lib/courses.ts
// walks: cohorts.course_id = <course> AND cohort_teachers.teacher_user_id = <actor>.
model CohortTeacher {
  cohortId      String   @map("cohort_id") @db.Uuid
  teacherUserId String   @map("teacher_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher User   @relation(fields: [teacherUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([cohortId, teacherUserId])
  @@index([teacherUserId])
  @@map("cohort_teachers")
}

model Enrollment {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId      String           @map("cohort_id") @db.Uuid
  studentUserId String           @map("student_user_id") @db.Uuid
  status        EnrollmentStatus @default(active)
  enrolledAt    DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(6)
  withdrawnAt   DateTime?        @map("withdrawn_at") @db.Timestamptz(6)

  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student User   @relation(fields: [studentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  certificates Certificate[]

  @@unique([cohortId, studentUserId])
  @@index([studentUserId])
  @@map("enrollments")
}

model Module {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String        @map("course_id") @db.Uuid
  title       String
  order       Int
  status      ContentStatus @default(draft)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lessons Lesson[]

  @@index([courseId])
  @@map("modules")
}

// courseId is denormalized from module.courseId — immutable once set
// (lessons are never moved across courses in this foundation). This keeps
// every RLS ownership/visibility check a single join (lessons.course_id ->
// cohorts -> cohort_teachers/enrollments) instead of a three-table walk
// through modules on every policy.
model Lesson {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId    String        @map("module_id") @db.Uuid
  courseId    String        @map("course_id") @db.Uuid
  title       String
  content     String
  order       Int
  status      ContentStatus @default(draft)
  version     Int           @default(0)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  module    Module           @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resources Resource[]
  versions  LessonVersion[]
  topics    LessonTopic[]
  progress  LessonProgress[]

  @@index([moduleId])
  @@index([courseId])
  @@map("lessons")
}

// Content-versioning foundation: an immutable snapshot taken every time a
// lesson is published, so a later draft edit can never silently rewrite
// what an already-published/completed lesson said. Nothing reads these
// yet (no Progress/Attempt model exists to pin a student's completion to a
// specific version) — that's for Session 07/08 to consume; this session
// only guarantees the history is captured and never overwritten.
model LessonVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId    String   @map("lesson_id") @db.Uuid
  version     Int
  title       String
  content     String
  publishedBy String   @map("published_by") @db.Uuid
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publisher User   @relation(fields: [publishedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([lessonId, version])
  @@index([lessonId])
  @@map("lesson_versions")
}

// Either an external URL (unchanged since Session 04) or a real
// upload-backed file via Asset (Session 13's Asset/File service) — exactly
// one of url/assetId is set, enforced by a CHECK constraint added directly
// in the assets_files migration (Prisma's schema DSL has no CHECK syntax).
model Resource {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId  String       @map("lesson_id") @db.Uuid
  title     String
  url       String?
  assetId   String?      @unique @map("asset_id") @db.Uuid
  type      ResourceType @default(link)
  createdBy String       @map("created_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator User   @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset   Asset? @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([lessonId])
  @@map("resources")
}

// Subject -> Topic -> Subtopic/Skill, modeled as one self-referential
// hierarchy rather than three separate tables. Tags Lesson content today;
// Session 07 (Assessment) is expected to reuse this same table to tag
// Question rows rather than building a parallel taxonomy.
model Topic {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parent         Topic?          @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       Topic[]         @relation("TopicHierarchy")
  lessonTopics   LessonTopic[]
  questionTopics QuestionTopic[]

  @@index([parentId])
  @@map("topics")
}

model LessonTopic {
  lessonId String @map("lesson_id") @db.Uuid
  topicId  String @map("topic_id") @db.Uuid

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([lessonId, topicId])
  @@index([topicId])
  @@map("lesson_topics")
}

// --- Student Workspace (Session 06) --------------------------------------
// Private, student-owned productivity data. Not part of Education Core
// (Course/Module/Lesson/Enrollment remain Session 04's canonical entities,
// referenced here, never redefined) and not a Progress/mastery system
// (Session 08 owns that) — just notes and saved-resource bookmarks a
// student attaches to their own learning content.
//
// targetType/targetId is a lightweight polymorphic reference rather than
// one nullable FK column per attachable type: "question" has no table yet
// (Session 07 hasn't run), so a real FK isn't even possible for that case,
// and this keeps course/module/lesson/resource/question notes one uniform
// shape instead of four one-off nullable columns. courseId is always
// populated (same denormalization pattern as Lesson.courseId) so the
// enrollment/ownership check src/lib/notes.ts and src/lib/bookmarks.ts
// perform, and the RLS policies below, are a single join instead of a walk
// through modules/lessons.

model StudentNote {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentUserId String         @map("student_user_id") @db.Uuid
  courseId      String         @map("course_id") @db.Uuid
  targetType    NoteTargetType @map("target_type")
  targetId      String         @map("target_id") @db.Uuid
  body          String
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  student User   @relation(fields: [studentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course  Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([studentUserId])
  @@index([courseId])
  @@index([targetType, targetId])
  @@map("student_notes")
}

// Saved lessons/resources ("Saved Resources") — restricted to the two
// content types that make sense to bookmark today.
model Bookmark {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentUserId String             @map("student_user_id") @db.Uuid
  courseId      String             @map("course_id") @db.Uuid
  targetType    BookmarkTargetType @map("target_type")
  targetId      String             @map("target_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  student User   @relation(fields: [studentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course  Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studentUserId, targetType, targetId])
  @@index([studentUserId])
  @@index([courseId])
  @@map("bookmarks")
}

// --- Assessment (Session 07) ---------------------------------------------
// Owns the question bank, assessments built from it, assignment to
// cohorts/students, student attempts/answers, and grading/results. Reuses
// Education Core's Course/Cohort/Enrollment (never redefined) and the
// Topic/LessonTopic taxonomy pattern for Question tagging, per Session 04's
// handoff. Authoring/publishing is ownership-scoped via cohort_teachers
// exactly like Module/Lesson (src/lib/courses.ts's
// requireCourseContentAccess()) — no new permission keys.
//
// Question (courseId-scoped bank, reusable across assessments)
//   -> AssessmentQuestion (join: which questions are on an assessment, in
//      what order, worth how many points)
//   -> Assessment (draft, live-editable — title/instructions/settings/
//      question list)
//   -> AssessmentVersion (immutable snapshot taken on every publish — the
//      content-versioning foundation, exact LessonVersion pattern applied
//      to a whole assessment tree: questions/options/correct-answers
//      denormalized into `questions` Json so a later edit to the live
//      Question bank or Assessment can NEVER retroactively change what an
//      already-attempted version asked or how it's graded)
//   -> Attempt (student's attempt, permanently bound to ONE AssessmentVersion
//      — never the live/mutable Assessment)
//   -> Answer (per-question response + grading outcome for that attempt)
//
// See docs/ASSESSMENT.md for the full contract, RLS policy shapes, and the
// "why AssessmentVersion.questions carries the answer key" note (RLS is a
// row-level backstop, not column-level — see Session 02's documented
// limitation — so hiding the answer key from an in-progress student attempt
// is enforced by application-layer redaction, not by a DB policy).

model Question {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId          String             @map("course_id") @db.Uuid
  type              QuestionType
  prompt            String
  explanation       String             @default("")
  difficulty        QuestionDifficulty @default(medium)
  learningObjective String             @default("") @map("learning_objective")
  // Short-answer only: optional case-insensitive exact-match auto-grade
  // candidates (e.g. ["Lagos", "lagos, nigeria"]). Null/empty -> every
  // short-answer response on this question requires manual grading.
  acceptableAnswers Json?              @map("acceptable_answers")
  createdBy         String             @map("created_by") @db.Uuid
  archivedAt        DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course              Course               @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator             User                 @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  options             QuestionOption[]
  topics              QuestionTopic[]
  assessmentQuestions AssessmentQuestion[]
  answers             Answer[]

  @@index([courseId])
  @@index([createdBy])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  order      Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([questionId])
  @@map("question_options")
}

model QuestionTopic {
  questionId String @map("question_id") @db.Uuid
  topicId    String @map("topic_id") @db.Uuid

  question Question @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topic    Topic    @relation(fields: [topicId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([questionId, topicId])
  @@index([topicId])
  @@map("question_topics")
}

model Assessment {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId            String           @map("course_id") @db.Uuid
  title               String
  instructions        String           @default("")
  status              AssessmentStatus @default(draft)
  version             Int              @default(0)
  timeLimitMinutes    Int?             @map("time_limit_minutes")
  maxAttempts         Int?             @map("max_attempts")
  passingScorePercent Int?             @map("passing_score_percent")
  createdBy           String           @map("created_by") @db.Uuid
  publishedAt         DateTime?        @map("published_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator     User                   @relation("AssessmentCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  questions   AssessmentQuestion[]
  versions    AssessmentVersion[]
  assignments AssessmentAssignment[]
  attempts    Attempt[]

  @@index([courseId])
  @@map("assessments")
}

// Bank -> assessment link: which questions, in what order, worth how many
// points. Live/mutable — editing this after a publish never touches past
// attempts, which are bound to an immutable AssessmentVersion snapshot.
model AssessmentQuestion {
  assessmentId String @map("assessment_id") @db.Uuid
  questionId   String @map("question_id") @db.Uuid
  order        Int
  points       Int    @default(1)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([assessmentId, questionId])
  @@index([questionId])
  @@map("assessment_questions")
}

// Immutable snapshot taken every time an assessment is (re)published —
// the versioning foundation the session brief requires ("never permanently
// overwrite historical attempts when an assessment changes"). `questions`
// denormalizes the full question/option/correct-answer tree as it stood at
// publish time; every Attempt is permanently bound to one specific row
// here, never to the live Assessment/Question rows, so later edits can
// never retroactively change what a student was asked or how they were
// graded. Append-only at the RLS layer (see migration), same shape as
// lesson_versions.
model AssessmentVersion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  version      Int
  title        String
  instructions String
  questions    Json
  publishedBy  String   @map("published_by") @db.Uuid
  publishedAt  DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publisher  User       @relation("AssessmentVersionPublisher", fields: [publishedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attempts   Attempt[]

  @@unique([assessmentId, version])
  @@index([assessmentId])
  @@map("assessment_versions")
}

// Assigns a published assessment to either a whole cohort or one specific
// student — exactly one of cohortId/studentUserId is set (enforced by a
// CHECK constraint in the migration, Prisma has no native XOR constraint).
//
// courseId is denormalized from assessment.course_id — same reasoning as
// Lesson.courseId (see that model's comment): assessments_select's
// student-visibility branch has to read assessment_assignments, and
// assessment_assignments_select's teacher-ownership branch has to resolve
// back to a course. Doing that second hop through the `assessments` table
// itself creates a genuine RLS policy cycle (Postgres evaluates a table
// reference inside a policy against that table's OWN policies, so
// assessments_select -> assessment_assignments -> assessments would recurse
// infinitely — hit exactly this while authoring the migration, confirmed
// via "infinite recursion detected in policy for relation" against a real
// non-superuser role). Denormalizing courseId breaks the cycle the same way
// Lesson.courseId keeps lessons_select a single join instead of a walk
// through modules.
model AssessmentAssignment {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId  String                    @map("assessment_id") @db.Uuid
  courseId      String                    @map("course_id") @db.Uuid
  scope         AssessmentAssignmentScope
  cohortId      String?                   @map("cohort_id") @db.Uuid
  studentUserId String?                   @map("student_user_id") @db.Uuid
  dueAt         DateTime?                 @map("due_at") @db.Timestamptz(6)
  createdBy     String                    @map("created_by") @db.Uuid
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cohort     Cohort?    @relation(fields: [cohortId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student    User?      @relation("AssessmentAssignmentStudent", fields: [studentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator    User       @relation("AssessmentAssignmentCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assessmentId])
  @@index([courseId])
  @@index([cohortId])
  @@index([studentUserId])
  @@map("assessment_assignments")
}

model Attempt {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId        String        @map("assessment_id") @db.Uuid
  assessmentVersionId String        @map("assessment_version_id") @db.Uuid
  studentUserId       String        @map("student_user_id") @db.Uuid
  attemptNumber       Int           @map("attempt_number")
  status              AttemptStatus @default(in_progress)
  startedAt           DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt         DateTime?     @map("submitted_at") @db.Timestamptz(6)
  gradedAt            DateTime?     @map("graded_at") @db.Timestamptz(6)
  gradedBy            String?       @map("graded_by") @db.Uuid
  scorePoints         Int?          @map("score_points")
  maxPoints           Int?          @map("max_points")
  scorePercent        Float?        @map("score_percent")
  passed              Boolean?

  assessment        Assessment        @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessmentVersion AssessmentVersion @relation(fields: [assessmentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student           User              @relation("AttemptStudent", fields: [studentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grader            User?             @relation("AttemptGrader", fields: [gradedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  answers           Answer[]

  @@unique([assessmentId, studentUserId, attemptNumber])
  @@index([studentUserId])
  @@index([assessmentId])
  @@index([assessmentVersionId])
  @@map("attempts")
}

model Answer {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId         String   @map("attempt_id") @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  selectedOptionIds Json?    @map("selected_option_ids")
  textResponse      String?  @map("text_response")
  // null = pending manual grade (short-answer, no acceptable-answer match).
  isCorrect         Boolean? @map("is_correct")
  awardedPoints     Int?     @map("awarded_points")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  question Question @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("answers")
}

// --- Progress & Adaptive Learning (Session 08) ---------------------------
// Core model: Student activity -> evidence -> progress/mastery -> views.
// Reuses Education Core (Course/Module/Lesson/Enrollment) and Assessment
// (Attempt/Answer/QuestionTopic) as the canonical evidence sources — this
// session adds exactly one new table (the missing evidence signal Session 04
// deliberately left unbuilt: "needs a Progress model to drive completion")
// plus pure read-time calculation functions (src/lib/progress.ts). No
// separate analytics database, no stored/cached mastery snapshot: topic
// mastery is always computed fresh from Attempt/Answer/QuestionTopic +
// LessonProgress/LessonTopic, so there is nothing to invalidate or drift out
// of sync with the underlying evidence.
//
// LessonProgress is a student's explicit "I completed this lesson" evidence
// record — deliberately NOT a page-view/time-on-page heuristic (unreliable,
// easy to game, not "trustworthy" per this session's mission) and
// deliberately NOT tracking an "in_progress" state (no product requirement
// for it; a row's mere existence is the complete signal). Append-only, same
// shape as lesson_versions/assessment_versions/audit_events — once a lesson
// is marked complete that record is permanent history; there is no UPDATE or
// DELETE RLS policy at all, for any role. courseId is denormalized from
// lesson.courseId, same pattern as Lesson.courseId itself, so the
// enrollment/ownership check (and every RLS policy below) is a single join.
model LessonProgress {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentUserId String   @map("student_user_id") @db.Uuid
  lessonId      String   @map("lesson_id") @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  completedAt   DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  student User   @relation(fields: [studentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course  Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studentUserId, lessonId])
  @@index([studentUserId])
  @@index([courseId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// --- Files & Content Assets (Session 13) ----------------------------------
// The canonical Asset/File service (PLATFORM_ARCHITECTURE.md §11): every
// upload in the platform — course resources today, message/sponsor-document/
// certificate attachments once those sessions land — is one Asset row here,
// never a second per-module file table. Postgres stores metadata only;
// bytes live behind src/lib/storage.ts's StorageDriver interface (local disk
// in dev — see docs/ASSETS.md for why no production object-storage backend
// exists yet), so swapping the storage vendor never touches this schema or
// any domain model that references an Asset.
//
// No UPDATE/DELETE policy at the RLS layer for either table below (same
// append-only shape as lesson_versions/assessment_versions/audit_events) —
// "deleting" an asset is an application-layer soft-delete
// (status=deleted, deletedAt set, storage bytes purged) via
// src/lib/assets.ts, never a real row DELETE, so a past attachment
// reference can never dangle silently.
model Asset {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploaderId       String      @map("uploader_id") @db.Uuid
  originalFilename String      @map("original_filename")
  mimeType         String      @map("mime_type")
  sizeBytes        Int         @map("size_bytes")
  storageDriver    String      @map("storage_driver")
  storageKey       String      @unique @map("storage_key")
  checksumSha256   String      @map("checksum_sha256")
  status           AssetStatus @default(active)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(6)

  uploader         User              @relation(fields: [uploaderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachments      AssetAttachment[]
  resources        Resource[]
  projectDocuments ProjectDocument[]

  @@index([uploaderId])
  @@map("assets")
}

// entityId is a lightweight polymorphic reference (no FK — the referenced
// table varies by entityType), same convention as StudentNote/Bookmark's
// targetType/targetId above. @@unique([entityType, entityId]) keeps today's
// relationship 1:1 (one lesson_resource Resource carries at most one Asset);
// a future entity type that legitimately needs many assets per entity would
// need this loosened — not required by anything in this session's scope.
model AssetAttachment {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId    String          @map("asset_id") @db.Uuid
  entityType AssetEntityType @map("entity_type")
  entityId   String          @map("entity_id") @db.Uuid
  attachedBy String          @map("attached_by") @db.Uuid
  attachedAt DateTime        @default(now()) @map("attached_at") @db.Timestamptz(6)

  asset    Asset @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attacher User  @relation(fields: [attachedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([entityType, entityId])
  @@index([assetId])
  @@map("asset_attachments")
}

// --- Messaging (Session 09) -----------------------------------------------
// The ONE canonical messaging system for the whole platform
// (PLATFORM_CONTEXT.md's "Shared communication rule") — every portal
// (teacher/student/admin) consumes this Conversation/ConversationParticipant/
// Message contract rather than building its own inbox table.
//
// Server-side participant authorization is the core guarantee: a user can
// read/send only in a conversation they hold a ConversationParticipant row
// for. The RLS policies (messaging_core migration) enforce this via a
// SECURITY DEFINER helper function, app_current_user_conversation_ids(),
// rather than a raw self-referencing subquery on conversation_participants
// from within that table's own SELECT policy — a naive self-join there is a
// well-documented Postgres RLS infinite-recursion trap, the same failure
// class as Sessions 08/13's cross-table cycles but triggered by a single
// table referencing itself. The function runs as the migrator/table owner
// (bypasses RLS internally, same as any owner-run query), so referencing it
// from a policy never re-triggers RLS rewriting on conversation_participants.
//
// Attachments reuse Session 13's Asset/File service via the 'message'
// AssetEntityType value + matching asset_attachments RLS branches (added in
// a separate migration, since a new enum value can't be used in the same
// transaction that adds it) — never a parallel attachment mechanism. A
// message carries at most one attachment (AssetAttachment's existing
// @@unique([entityType, entityId]) constraint, per Session 13's own
// documented limitation).
//
// Participant set is fixed at conversation-creation time — no add/remove-
// participant-later feature, not required by this session's acceptance
// criteria. Messages are permanent once sent (no edit/delete), same
// append-only spirit as lesson_versions/audit_events/asset rows.
//
// WHO may start a conversation with whom is application-layer relationship
// logic (src/lib/messaging.ts's assertCanMessage), mirroring how
// courses.content.write is necessary-but-not-sufficient without a matching
// cohort_teachers row: holding `messages.send` is necessary but the real
// scope check is "do these two users share a cohort as teacher/student or
// as fellow students," computed fresh from Session 04's canonical
// CohortTeacher/Enrollment tables — never a duplicated relationship table.
// `messages.admin` (ADMIN/SUPER_ADMIN) bypasses the relationship check
// entirely, matching the "Admin -> permitted users" required use case.
//
// See docs/MESSAGING.md for the full contract.
enum ConversationType {
  direct
  group
  cohort_broadcast
}

model Conversation {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            ConversationType
  contextCohortId String?          @map("context_cohort_id") @db.Uuid
  createdBy       String           @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  lastMessageAt   DateTime?        @map("last_message_at") @db.Timestamptz(6)

  creator       User                      @relation("ConversationCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contextCohort Cohort?                   @relation(fields: [contextCohortId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([createdBy])
  @@index([contextCohortId])
  @@map("conversations")
}

// Fixed at creation time (see Conversation's own comment above). lastReadAt
// drives per-participant unread counts, computed at read time (count of
// messages.sentAt > lastReadAt from other senders) — same "no stored/
// cached derived state" spirit as Session 08's read-time mastery
// calculation, nothing to invalidate or let drift out of sync.
model ConversationParticipant {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String
  sentAt         DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([conversationId, sentAt])
  @@index([senderId])
  @@map("messages")
}

// --- Notifications (Session 10) ------------------------------------------
// The ONE canonical notification center for the whole platform
// (PLATFORM_CONTEXT.md's "Shared communication rule" — "notifications" is
// listed as a platform-core service exactly like messaging). Every domain
// event this session maps into a notification (see src/lib/notifications.ts)
// writes into THIS table; no portal owns a parallel notification table.
//
// entityType/entityId is the same lightweight polymorphic reference
// convention as StudentNote/Bookmark's targetType/targetId and
// AssetAttachment's entityType/entityId — but modeled as plain TEXT (not an
// enum) because it spans every domain in the platform (conversation,
// attempt, course, certificate, project, ...), the same reasoning
// AuditEvent.entityType already uses. `metadata` carries whatever extra
// structured context a notification's link/rendering needs beyond one id
// (e.g. assessment_submitted needs both an attemptId AND the assessmentId
// to build the teacher's attempt-review route) — same purpose as
// AuditEvent.metadata.
//
// dedupeKey is the duplicate-delivery-protection mechanism (explicit
// acceptance criterion): each event listener in src/lib/notifications.ts
// derives it from the driving event's own natural identity (e.g. a specific
// messageId, a specific gradedAt timestamp on a specific attempt) so the
// SAME real-world occurrence delivered twice (a re-registered listener, a
// caller that emits idempotently, or a future durable-queue redelivery once
// events.ts's transport is swapped per its own docstring) creates at most
// one row and triggers channel delivery (e.g. email) at most once — while a
// genuinely NEW occurrence for the same recipient/type (a second message, a
// re-grade, a re-enrollment) still gets its own notification. See
// docs/NOTIFICATIONS.md's "Duplicate delivery protection" section for which
// event types have a fully precise key vs. a documented weaker one.
//
// No UPDATE policy beyond the recipient marking their own readAt, and no
// DELETE policy at all for any role — same append-oriented spirit as
// audit_events, just with one mutable field.
model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  type        NotificationType
  title       String
  body        String
  entityType  String?          @map("entity_type")
  entityId    String?          @map("entity_id")
  metadata    Json?
  dedupeKey   String           @map("dedupe_key")
  readAt      DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient User @relation(fields: [recipientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("notifications")
}

// --- Sponsor Core (Session 11) --------------------------------------------
// Extends the Phase-1 Sponsor/Project/ProjectMembership scaffold (already
// in the schema — see those models above) rather than replacing it.
// Authorization is rebuilt on Session 02's Role/Permission model
// (PERMISSIONS.SPONSOR_MANAGE / SPONSOR_PROJECTS_READ / SPONSOR_USERS_MANAGE,
// src/lib/authz.ts) layered on ProjectMembership as the ownership/
// relationship check — the exact same "permission + ownership row" shape
// Education Core uses (courses.content.write + cohort_teachers). See
// docs/SPONSOR_CORE.md for the full contract.
//
// Milestones/metrics/documents are admin/staff-authored (sponsor.manage);
// sponsor-side users (SPONSOR_ADMIN/SPONSOR_USER, ownership-scoped via
// ProjectMembership) are read-only over their own permitted projects' data
// — matches the session brief's "sponsor dashboard... reports/documents"
// as a visibility surface, not a sponsor-editable one. Beneficiary rows
// (ProjectMembership role='beneficiary') are read via a dedicated,
// privacy-aware summary function (src/lib/sponsor.ts's
// listProjectBeneficiaries) that never exposes email/contact/academic
// data to a sponsor — see that file's header for why this can't be a
// plain RLS-scoped join against `users`.

enum MilestoneStatus {
  planned
  in_progress
  achieved
  missed
}

model Milestone {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  title       String
  description String?
  targetDate  DateTime?       @map("target_date") @db.Timestamptz(6)
  status      MilestoneStatus @default(planned)
  achievedAt  DateTime?       @map("achieved_at") @db.Timestamptz(6)
  createdBy   String          @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([projectId])
  @@map("milestones")
}

// Point-in-time impact metric samples ("beneficiaries reached: 120",
// "attendance rate: 92%"), not a running total — multiple rows per label
// over time form the reporting time series Session 12 (Reporting & Impact)
// consumes (see getProjectImpactSummary in src/lib/sponsor.ts). Append-only
// by convention (no update/delete RLS policy — a correction is a new
// sample, not a rewrite of history, same reasoning as lesson_versions/
// audit_events).
model ProjectMetric {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  label      String
  value      Float
  unit       String?
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([projectId, label, recordedAt])
  @@map("project_metrics")
}

// Anchor row for a sponsor-visible document upload — the same shape as
// Resource for 'lesson_resource' (Session 13's convention: AssetAttachment
// needs a dedicated business row per attached file since @@unique
// ([entityType, entityId]) is 1:1, and a project needs to hold many
// documents over time).
model ProjectDocument {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  title      String
  assetId    String   @unique @map("asset_id") @db.Uuid
  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project  Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploader User    @relation(fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset    Asset   @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([projectId])
  @@map("project_documents")
}

// --- Certificates (Session 14) --------------------------------------------
//
// Certificate issuance is driven entirely by Progress's (Session 08) own
// completion signal — enrollments.status = 'completed' — never recomputed
// here from lesson/module counts (see src/lib/certificates.ts's
// issueCertificateIfEligible). *_snapshot fields are copied at issuance and
// never re-derived, so a later course rename/re-authoring cannot silently
// change an already-issued certificate's displayed content (acceptance
// criterion: "historical certificate record remains stable even if course
// content changes"). The optional downloadable file (Owns: "optional
// downloadable certificate through Asset service") attaches through the
// existing generic AssetAttachment join (entity_type = 'certificate', see
// the two follow-up migrations extending Session 13's Asset service) —
// never a parallel file mechanism.
enum CertificateStatus {
  active
  revoked
}

model Certificate {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentUserId       String            @map("student_user_id") @db.Uuid
  courseId            String            @map("course_id") @db.Uuid
  enrollmentId        String            @map("enrollment_id") @db.Uuid
  certificateNumber   String            @unique @map("certificate_number")
  status              CertificateStatus @default(active)
  templateVersion     Int               @default(1) @map("template_version")
  studentNameSnapshot String            @map("student_name_snapshot")
  courseTitleSnapshot String            @map("course_title_snapshot")
  completedAt         DateTime          @map("completed_at") @db.Timestamptz(6)
  issuedAt            DateTime          @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt           DateTime?         @map("revoked_at") @db.Timestamptz(6)
  revokedBy           String?           @map("revoked_by") @db.Uuid
  revokedReason       String?           @map("revoked_reason")

  student    User       @relation("CertificateStudent", fields: [studentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revoker    User?      @relation("CertificateRevoker", fields: [revokedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studentUserId, courseId])
  @@index([studentUserId])
  @@index([courseId])
  @@map("certificates")
}
