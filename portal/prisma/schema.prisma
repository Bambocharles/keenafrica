generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  draft
  active
  paused
}

enum MembershipRole {
  sponsor_admin
  beneficiary
}

enum UserStatus {
  active
  suspended
}

// Education Core (Session 04).
enum CourseStatus {
  draft
  published
  archived
}

enum ContentStatus {
  draft
  published
  archived
}

enum CohortStatus {
  active
  archived
}

enum EnrollmentStatus {
  active
  completed
  withdrawn
}

enum ResourceType {
  link
  document
  video
}

// Session 06 (Student).
enum NoteTargetType {
  course
  module
  lesson
  resource
  question
}

enum BookmarkTargetType {
  lesson
  resource
}

// Session 07 (Assessment).
enum QuestionType {
  single_choice
  multiple_choice
  short_answer
}

enum QuestionDifficulty {
  easy
  medium
  hard
}

enum AssessmentStatus {
  draft
  published
  archived
}

enum AssessmentAssignmentScope {
  cohort
  student
}

enum AttemptStatus {
  in_progress
  submitted
  graded
}

// Session 08 (Progress & Adaptive Learning). No status enum — a row's mere
// existence IS the evidence (a student completed this lesson); see
// LessonProgress's own comment for why there's no "in_progress" state.

// Session 13 (Files & Content Assets). Canonical Asset/File service —
// storage-vendor-agnostic (see src/lib/storage.ts): Postgres only ever
// stores metadata, never binary content. AssetAttachment is a generic,
// polymorphic join (the same targetType/targetId shape as
// NoteTargetType/BookmarkTargetType above) so Messaging/Sponsor/
// Certificates (Sessions 09/11/14) attach to the same Asset table by adding
// their own AssetEntityType value + a matching case in
// src/lib/assets.ts's visibility resolver, instead of building a parallel
// TeacherFiles/StudentFiles/SponsorFiles system. Only "lesson_resource"
// exists today — the one real, wired consumer (Resource, Session 04).
enum AssetStatus {
  active
  deleted
}

enum AssetEntityType {
  lesson_resource
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique @db.Citext
  passwordHash String     @map("password_hash")
  name         String
  isSuperAdmin Boolean    @default(false) @map("is_super_admin")
  status       UserStatus @default(active)
  suspendedAt  DateTime?  @map("suspended_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         ProjectMembership[]
  userRoles           UserRole[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditEventsAsActor  AuditEvent[]         @relation("AuditActor")

  coursesCreated          Course[]        @relation("CourseCreator")
  cohortTeaching          CohortTeacher[]
  enrollments             Enrollment[]
  lessonVersionsPublished LessonVersion[]
  resourcesCreated        Resource[]
  studentNotes            StudentNote[]
  bookmarks               Bookmark[]

  assetsUploaded       Asset[]
  assetAttachmentsMade AssetAttachment[]

  questionsCreated               Question[]
  assessmentsCreated             Assessment[]           @relation("AssessmentCreator")
  assessmentVersionsPublished    AssessmentVersion[]    @relation("AssessmentVersionPublisher")
  assessmentAssignmentsCreated   AssessmentAssignment[] @relation("AssessmentAssignmentCreator")
  assessmentAssignmentsAsStudent AssessmentAssignment[] @relation("AssessmentAssignmentStudent")
  attemptsAsStudent              Attempt[]              @relation("AttemptStudent")
  attemptsGraded                 Attempt[]              @relation("AttemptGrader")

  lessonProgress LessonProgress[]

  @@map("users")
}

// Identity/authorization foundation (Session 02). Additive to the existing
// isSuperAdmin flag, not a replacement: isSuperAdmin remains the RLS bypass
// baked into every table's policies (see rls.ts); Role/Permission add
// finer-grained, least-privilege capability for non-super-admin actors.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

// What a role CAN do. Deliberately writable by super-admin only (see
// migration RLS comment) — a role holding `roles.manage` may assign
// existing roles to users, but may not redefine what any role means. That
// distinction blocks a straightforward privilege-escalation path.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Which role(s) a user holds. Many-to-many — a user can be e.g. both
// TEACHER and SPONSOR_USER.
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, roleId])
  @@map("user_roles")
}

// DB-backed session record, checked on every request (see src/lib/sessions.ts
// and the jwt callback in src/lib/auth.ts). This is what makes JWT-strategy
// sessions actually revocable: the JWT only ever carries this row's id: the
// row itself is the source of truth for whether the session is still valid.
model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy String?   @map("revoked_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@map("sessions")
}

// Single-use, time-limited, hashed-at-rest password reset tokens. The raw
// token is returned once (to whatever calls requestPasswordReset) and never
// stored — only its SHA-256 hash is persisted, so a DB read can never
// recover a usable token.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Append-only. No UPDATE/DELETE RLS policy exists for this table at all —
// see the migration — so ordinary application code cannot alter or remove
// an audit record, only insert new ones.
model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_events")
}

model Sponsor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  projects Project[]

  @@map("sponsors")
}

model Project {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sponsorId String        @map("sponsor_id") @db.Uuid
  name      String
  slug      String        @unique
  status    ProjectStatus @default(active)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sponsor     Sponsor             @relation(fields: [sponsorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberships ProjectMembership[]

  @@map("projects")
}

model FeatureFlag {
  key         String   @id
  description String
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model ProjectMembership {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, projectId])
  @@map("project_memberships")
}

// --- Education Core (Session 04) ---------------------------------------
// Course -> Cohort -> Teacher(s) + Students
// Course -> Modules -> Lessons -> Resources
// See docs/EDUCATION_CORE.md for the full ownership/visibility model and
// the RLS policies in this migration's SQL.

model Course {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String       @default("")
  status      CourseStatus @default(draft)
  createdBy   String       @map("created_by") @db.Uuid
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator               User                   @relation("CourseCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cohorts               Cohort[]
  modules               Module[]
  lessons               Lesson[]
  studentNotes          StudentNote[]
  bookmarks             Bookmark[]
  questions             Question[]
  assessments           Assessment[]
  assessmentAssignments AssessmentAssignment[]
  lessonProgress        LessonProgress[]

  @@index([createdBy])
  @@map("courses")
}

model Cohort {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String       @map("course_id") @db.Uuid
  name      String
  status    CohortStatus @default(active)
  startsAt  DateTime?    @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime?    @map("ends_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course                Course                 @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teachers              CohortTeacher[]
  enrollments           Enrollment[]
  assessmentAssignments AssessmentAssignment[]

  @@index([courseId])
  @@map("cohorts")
}

// Many-to-many: a cohort can have multiple teachers, a teacher can teach
// multiple cohorts. This — not a direct Course->Teacher link — is the
// ownership boundary every content-authorization check in src/lib/courses.ts
// walks: cohorts.course_id = <course> AND cohort_teachers.teacher_user_id = <actor>.
model CohortTeacher {
  cohortId      String   @map("cohort_id") @db.Uuid
  teacherUserId String   @map("teacher_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher User   @relation(fields: [teacherUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([cohortId, teacherUserId])
  @@index([teacherUserId])
  @@map("cohort_teachers")
}

model Enrollment {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId      String           @map("cohort_id") @db.Uuid
  studentUserId String           @map("student_user_id") @db.Uuid
  status        EnrollmentStatus @default(active)
  enrolledAt    DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(6)
  withdrawnAt   DateTime?        @map("withdrawn_at") @db.Timestamptz(6)

  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student User   @relation(fields: [studentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cohortId, studentUserId])
  @@index([studentUserId])
  @@map("enrollments")
}

model Module {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String        @map("course_id") @db.Uuid
  title       String
  order       Int
  status      ContentStatus @default(draft)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lessons Lesson[]

  @@index([courseId])
  @@map("modules")
}

// courseId is denormalized from module.courseId — immutable once set
// (lessons are never moved across courses in this foundation). This keeps
// every RLS ownership/visibility check a single join (lessons.course_id ->
// cohorts -> cohort_teachers/enrollments) instead of a three-table walk
// through modules on every policy.
model Lesson {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId    String        @map("module_id") @db.Uuid
  courseId    String        @map("course_id") @db.Uuid
  title       String
  content     String
  order       Int
  status      ContentStatus @default(draft)
  version     Int           @default(0)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  module    Module           @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resources Resource[]
  versions  LessonVersion[]
  topics    LessonTopic[]
  progress  LessonProgress[]

  @@index([moduleId])
  @@index([courseId])
  @@map("lessons")
}

// Content-versioning foundation: an immutable snapshot taken every time a
// lesson is published, so a later draft edit can never silently rewrite
// what an already-published/completed lesson said. Nothing reads these
// yet (no Progress/Attempt model exists to pin a student's completion to a
// specific version) — that's for Session 07/08 to consume; this session
// only guarantees the history is captured and never overwritten.
model LessonVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId    String   @map("lesson_id") @db.Uuid
  version     Int
  title       String
  content     String
  publishedBy String   @map("published_by") @db.Uuid
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publisher User   @relation(fields: [publishedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([lessonId, version])
  @@index([lessonId])
  @@map("lesson_versions")
}

// Either an external URL (unchanged since Session 04) or a real
// upload-backed file via Asset (Session 13's Asset/File service) — exactly
// one of url/assetId is set, enforced by a CHECK constraint added directly
// in the assets_files migration (Prisma's schema DSL has no CHECK syntax).
model Resource {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId  String       @map("lesson_id") @db.Uuid
  title     String
  url       String?
  assetId   String?      @unique @map("asset_id") @db.Uuid
  type      ResourceType @default(link)
  createdBy String       @map("created_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator User   @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset   Asset? @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([lessonId])
  @@map("resources")
}

// Subject -> Topic -> Subtopic/Skill, modeled as one self-referential
// hierarchy rather than three separate tables. Tags Lesson content today;
// Session 07 (Assessment) is expected to reuse this same table to tag
// Question rows rather than building a parallel taxonomy.
model Topic {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parent         Topic?          @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       Topic[]         @relation("TopicHierarchy")
  lessonTopics   LessonTopic[]
  questionTopics QuestionTopic[]

  @@index([parentId])
  @@map("topics")
}

model LessonTopic {
  lessonId String @map("lesson_id") @db.Uuid
  topicId  String @map("topic_id") @db.Uuid

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([lessonId, topicId])
  @@index([topicId])
  @@map("lesson_topics")
}

// --- Student Workspace (Session 06) --------------------------------------
// Private, student-owned productivity data. Not part of Education Core
// (Course/Module/Lesson/Enrollment remain Session 04's canonical entities,
// referenced here, never redefined) and not a Progress/mastery system
// (Session 08 owns that) — just notes and saved-resource bookmarks a
// student attaches to their own learning content.
//
// targetType/targetId is a lightweight polymorphic reference rather than
// one nullable FK column per attachable type: "question" has no table yet
// (Session 07 hasn't run), so a real FK isn't even possible for that case,
// and this keeps course/module/lesson/resource/question notes one uniform
// shape instead of four one-off nullable columns. courseId is always
// populated (same denormalization pattern as Lesson.courseId) so the
// enrollment/ownership check src/lib/notes.ts and src/lib/bookmarks.ts
// perform, and the RLS policies below, are a single join instead of a walk
// through modules/lessons.

model StudentNote {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentUserId String         @map("student_user_id") @db.Uuid
  courseId      String         @map("course_id") @db.Uuid
  targetType    NoteTargetType @map("target_type")
  targetId      String         @map("target_id") @db.Uuid
  body          String
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  student User   @relation(fields: [studentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course  Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([studentUserId])
  @@index([courseId])
  @@index([targetType, targetId])
  @@map("student_notes")
}

// Saved lessons/resources ("Saved Resources") — restricted to the two
// content types that make sense to bookmark today.
model Bookmark {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentUserId String             @map("student_user_id") @db.Uuid
  courseId      String             @map("course_id") @db.Uuid
  targetType    BookmarkTargetType @map("target_type")
  targetId      String             @map("target_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  student User   @relation(fields: [studentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course  Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studentUserId, targetType, targetId])
  @@index([studentUserId])
  @@index([courseId])
  @@map("bookmarks")
}

// --- Assessment (Session 07) ---------------------------------------------
// Owns the question bank, assessments built from it, assignment to
// cohorts/students, student attempts/answers, and grading/results. Reuses
// Education Core's Course/Cohort/Enrollment (never redefined) and the
// Topic/LessonTopic taxonomy pattern for Question tagging, per Session 04's
// handoff. Authoring/publishing is ownership-scoped via cohort_teachers
// exactly like Module/Lesson (src/lib/courses.ts's
// requireCourseContentAccess()) — no new permission keys.
//
// Question (courseId-scoped bank, reusable across assessments)
//   -> AssessmentQuestion (join: which questions are on an assessment, in
//      what order, worth how many points)
//   -> Assessment (draft, live-editable — title/instructions/settings/
//      question list)
//   -> AssessmentVersion (immutable snapshot taken on every publish — the
//      content-versioning foundation, exact LessonVersion pattern applied
//      to a whole assessment tree: questions/options/correct-answers
//      denormalized into `questions` Json so a later edit to the live
//      Question bank or Assessment can NEVER retroactively change what an
//      already-attempted version asked or how it's graded)
//   -> Attempt (student's attempt, permanently bound to ONE AssessmentVersion
//      — never the live/mutable Assessment)
//   -> Answer (per-question response + grading outcome for that attempt)
//
// See docs/ASSESSMENT.md for the full contract, RLS policy shapes, and the
// "why AssessmentVersion.questions carries the answer key" note (RLS is a
// row-level backstop, not column-level — see Session 02's documented
// limitation — so hiding the answer key from an in-progress student attempt
// is enforced by application-layer redaction, not by a DB policy).

model Question {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId          String             @map("course_id") @db.Uuid
  type              QuestionType
  prompt            String
  explanation       String             @default("")
  difficulty        QuestionDifficulty @default(medium)
  learningObjective String             @default("") @map("learning_objective")
  // Short-answer only: optional case-insensitive exact-match auto-grade
  // candidates (e.g. ["Lagos", "lagos, nigeria"]). Null/empty -> every
  // short-answer response on this question requires manual grading.
  acceptableAnswers Json?              @map("acceptable_answers")
  createdBy         String             @map("created_by") @db.Uuid
  archivedAt        DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course              Course               @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator             User                 @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  options             QuestionOption[]
  topics              QuestionTopic[]
  assessmentQuestions AssessmentQuestion[]
  answers             Answer[]

  @@index([courseId])
  @@index([createdBy])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  order      Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([questionId])
  @@map("question_options")
}

model QuestionTopic {
  questionId String @map("question_id") @db.Uuid
  topicId    String @map("topic_id") @db.Uuid

  question Question @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topic    Topic    @relation(fields: [topicId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([questionId, topicId])
  @@index([topicId])
  @@map("question_topics")
}

model Assessment {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId            String           @map("course_id") @db.Uuid
  title               String
  instructions        String           @default("")
  status              AssessmentStatus @default(draft)
  version             Int              @default(0)
  timeLimitMinutes    Int?             @map("time_limit_minutes")
  maxAttempts         Int?             @map("max_attempts")
  passingScorePercent Int?             @map("passing_score_percent")
  createdBy           String           @map("created_by") @db.Uuid
  publishedAt         DateTime?        @map("published_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator     User                   @relation("AssessmentCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  questions   AssessmentQuestion[]
  versions    AssessmentVersion[]
  assignments AssessmentAssignment[]
  attempts    Attempt[]

  @@index([courseId])
  @@map("assessments")
}

// Bank -> assessment link: which questions, in what order, worth how many
// points. Live/mutable — editing this after a publish never touches past
// attempts, which are bound to an immutable AssessmentVersion snapshot.
model AssessmentQuestion {
  assessmentId String @map("assessment_id") @db.Uuid
  questionId   String @map("question_id") @db.Uuid
  order        Int
  points       Int    @default(1)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([assessmentId, questionId])
  @@index([questionId])
  @@map("assessment_questions")
}

// Immutable snapshot taken every time an assessment is (re)published —
// the versioning foundation the session brief requires ("never permanently
// overwrite historical attempts when an assessment changes"). `questions`
// denormalizes the full question/option/correct-answer tree as it stood at
// publish time; every Attempt is permanently bound to one specific row
// here, never to the live Assessment/Question rows, so later edits can
// never retroactively change what a student was asked or how they were
// graded. Append-only at the RLS layer (see migration), same shape as
// lesson_versions.
model AssessmentVersion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  version      Int
  title        String
  instructions String
  questions    Json
  publishedBy  String   @map("published_by") @db.Uuid
  publishedAt  DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publisher  User       @relation("AssessmentVersionPublisher", fields: [publishedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attempts   Attempt[]

  @@unique([assessmentId, version])
  @@index([assessmentId])
  @@map("assessment_versions")
}

// Assigns a published assessment to either a whole cohort or one specific
// student — exactly one of cohortId/studentUserId is set (enforced by a
// CHECK constraint in the migration, Prisma has no native XOR constraint).
//
// courseId is denormalized from assessment.course_id — same reasoning as
// Lesson.courseId (see that model's comment): assessments_select's
// student-visibility branch has to read assessment_assignments, and
// assessment_assignments_select's teacher-ownership branch has to resolve
// back to a course. Doing that second hop through the `assessments` table
// itself creates a genuine RLS policy cycle (Postgres evaluates a table
// reference inside a policy against that table's OWN policies, so
// assessments_select -> assessment_assignments -> assessments would recurse
// infinitely — hit exactly this while authoring the migration, confirmed
// via "infinite recursion detected in policy for relation" against a real
// non-superuser role). Denormalizing courseId breaks the cycle the same way
// Lesson.courseId keeps lessons_select a single join instead of a walk
// through modules.
model AssessmentAssignment {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId  String                    @map("assessment_id") @db.Uuid
  courseId      String                    @map("course_id") @db.Uuid
  scope         AssessmentAssignmentScope
  cohortId      String?                   @map("cohort_id") @db.Uuid
  studentUserId String?                   @map("student_user_id") @db.Uuid
  dueAt         DateTime?                 @map("due_at") @db.Timestamptz(6)
  createdBy     String                    @map("created_by") @db.Uuid
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cohort     Cohort?    @relation(fields: [cohortId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student    User?      @relation("AssessmentAssignmentStudent", fields: [studentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator    User       @relation("AssessmentAssignmentCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assessmentId])
  @@index([courseId])
  @@index([cohortId])
  @@index([studentUserId])
  @@map("assessment_assignments")
}

model Attempt {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId        String        @map("assessment_id") @db.Uuid
  assessmentVersionId String        @map("assessment_version_id") @db.Uuid
  studentUserId       String        @map("student_user_id") @db.Uuid
  attemptNumber       Int           @map("attempt_number")
  status              AttemptStatus @default(in_progress)
  startedAt           DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt         DateTime?     @map("submitted_at") @db.Timestamptz(6)
  gradedAt            DateTime?     @map("graded_at") @db.Timestamptz(6)
  gradedBy            String?       @map("graded_by") @db.Uuid
  scorePoints         Int?          @map("score_points")
  maxPoints           Int?          @map("max_points")
  scorePercent        Float?        @map("score_percent")
  passed              Boolean?

  assessment        Assessment        @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessmentVersion AssessmentVersion @relation(fields: [assessmentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student           User              @relation("AttemptStudent", fields: [studentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grader            User?             @relation("AttemptGrader", fields: [gradedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  answers           Answer[]

  @@unique([assessmentId, studentUserId, attemptNumber])
  @@index([studentUserId])
  @@index([assessmentId])
  @@index([assessmentVersionId])
  @@map("attempts")
}

model Answer {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId         String   @map("attempt_id") @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  selectedOptionIds Json?    @map("selected_option_ids")
  textResponse      String?  @map("text_response")
  // null = pending manual grade (short-answer, no acceptable-answer match).
  isCorrect         Boolean? @map("is_correct")
  awardedPoints     Int?     @map("awarded_points")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  question Question @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("answers")
}

// --- Progress & Adaptive Learning (Session 08) ---------------------------
// Core model: Student activity -> evidence -> progress/mastery -> views.
// Reuses Education Core (Course/Module/Lesson/Enrollment) and Assessment
// (Attempt/Answer/QuestionTopic) as the canonical evidence sources — this
// session adds exactly one new table (the missing evidence signal Session 04
// deliberately left unbuilt: "needs a Progress model to drive completion")
// plus pure read-time calculation functions (src/lib/progress.ts). No
// separate analytics database, no stored/cached mastery snapshot: topic
// mastery is always computed fresh from Attempt/Answer/QuestionTopic +
// LessonProgress/LessonTopic, so there is nothing to invalidate or drift out
// of sync with the underlying evidence.
//
// LessonProgress is a student's explicit "I completed this lesson" evidence
// record — deliberately NOT a page-view/time-on-page heuristic (unreliable,
// easy to game, not "trustworthy" per this session's mission) and
// deliberately NOT tracking an "in_progress" state (no product requirement
// for it; a row's mere existence is the complete signal). Append-only, same
// shape as lesson_versions/assessment_versions/audit_events — once a lesson
// is marked complete that record is permanent history; there is no UPDATE or
// DELETE RLS policy at all, for any role. courseId is denormalized from
// lesson.courseId, same pattern as Lesson.courseId itself, so the
// enrollment/ownership check (and every RLS policy below) is a single join.
model LessonProgress {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentUserId String   @map("student_user_id") @db.Uuid
  lessonId      String   @map("lesson_id") @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  completedAt   DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  student User   @relation(fields: [studentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course  Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studentUserId, lessonId])
  @@index([studentUserId])
  @@index([courseId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// --- Files & Content Assets (Session 13) ----------------------------------
// The canonical Asset/File service (PLATFORM_ARCHITECTURE.md §11): every
// upload in the platform — course resources today, message/sponsor-document/
// certificate attachments once those sessions land — is one Asset row here,
// never a second per-module file table. Postgres stores metadata only;
// bytes live behind src/lib/storage.ts's StorageDriver interface (local disk
// in dev — see docs/ASSETS.md for why no production object-storage backend
// exists yet), so swapping the storage vendor never touches this schema or
// any domain model that references an Asset.
//
// No UPDATE/DELETE policy at the RLS layer for either table below (same
// append-only shape as lesson_versions/assessment_versions/audit_events) —
// "deleting" an asset is an application-layer soft-delete
// (status=deleted, deletedAt set, storage bytes purged) via
// src/lib/assets.ts, never a real row DELETE, so a past attachment
// reference can never dangle silently.
model Asset {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploaderId       String      @map("uploader_id") @db.Uuid
  originalFilename String      @map("original_filename")
  mimeType         String      @map("mime_type")
  sizeBytes        Int         @map("size_bytes")
  storageDriver    String      @map("storage_driver")
  storageKey       String      @unique @map("storage_key")
  checksumSha256   String      @map("checksum_sha256")
  status           AssetStatus @default(active)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(6)

  uploader    User              @relation(fields: [uploaderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachments AssetAttachment[]
  resources   Resource[]

  @@index([uploaderId])
  @@map("assets")
}

// entityId is a lightweight polymorphic reference (no FK — the referenced
// table varies by entityType), same convention as StudentNote/Bookmark's
// targetType/targetId above. @@unique([entityType, entityId]) keeps today's
// relationship 1:1 (one lesson_resource Resource carries at most one Asset);
// a future entity type that legitimately needs many assets per entity would
// need this loosened — not required by anything in this session's scope.
model AssetAttachment {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId    String          @map("asset_id") @db.Uuid
  entityType AssetEntityType @map("entity_type")
  entityId   String          @map("entity_id") @db.Uuid
  attachedBy String          @map("attached_by") @db.Uuid
  attachedAt DateTime        @default(now()) @map("attached_at") @db.Timestamptz(6)

  asset    Asset @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attacher User  @relation(fields: [attachedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([entityType, entityId])
  @@index([assetId])
  @@map("asset_attachments")
}
