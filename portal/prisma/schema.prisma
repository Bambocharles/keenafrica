generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  draft
  active
  paused
}

enum MembershipRole {
  sponsor_admin
  beneficiary
}

enum UserStatus {
  active
  suspended
}

// Education Core (Session 04).
enum CourseStatus {
  draft
  published
  archived
}

enum ContentStatus {
  draft
  published
  archived
}

enum CohortStatus {
  active
  archived
}

enum EnrollmentStatus {
  active
  completed
  withdrawn
}

enum ResourceType {
  link
  document
  video
}

model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique @db.Citext
  passwordHash  String     @map("password_hash")
  name          String
  isSuperAdmin  Boolean    @default(false) @map("is_super_admin")
  status        UserStatus @default(active)
  suspendedAt   DateTime?  @map("suspended_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         ProjectMembership[]
  userRoles           UserRole[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditEventsAsActor  AuditEvent[]          @relation("AuditActor")

  coursesCreated     Course[]        @relation("CourseCreator")
  cohortTeaching     CohortTeacher[]
  enrollments        Enrollment[]
  lessonVersionsPublished LessonVersion[]
  resourcesCreated   Resource[]

  @@map("users")
}

// Identity/authorization foundation (Session 02). Additive to the existing
// isSuperAdmin flag, not a replacement: isSuperAdmin remains the RLS bypass
// baked into every table's policies (see rls.ts); Role/Permission add
// finer-grained, least-privilege capability for non-super-admin actors.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

// What a role CAN do. Deliberately writable by super-admin only (see
// migration RLS comment) — a role holding `roles.manage` may assign
// existing roles to users, but may not redefine what any role means. That
// distinction blocks a straightforward privilege-escalation path.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Which role(s) a user holds. Many-to-many — a user can be e.g. both
// TEACHER and SPONSOR_USER.
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, roleId])
  @@map("user_roles")
}

// DB-backed session record, checked on every request (see src/lib/sessions.ts
// and the jwt callback in src/lib/auth.ts). This is what makes JWT-strategy
// sessions actually revocable: the JWT only ever carries this row's id: the
// row itself is the source of truth for whether the session is still valid.
model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy String?   @map("revoked_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@map("sessions")
}

// Single-use, time-limited, hashed-at-rest password reset tokens. The raw
// token is returned once (to whatever calls requestPasswordReset) and never
// stored — only its SHA-256 hash is persisted, so a DB read can never
// recover a usable token.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Append-only. No UPDATE/DELETE RLS policy exists for this table at all —
// see the migration — so ordinary application code cannot alter or remove
// an audit record, only insert new ones.
model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_events")
}

model Sponsor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  projects Project[]

  @@map("sponsors")
}

model Project {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sponsorId String        @map("sponsor_id") @db.Uuid
  name      String
  slug      String        @unique
  status    ProjectStatus @default(active)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sponsor     Sponsor              @relation(fields: [sponsorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberships ProjectMembership[]

  @@map("projects")
}

model FeatureFlag {
  key         String   @id
  description String
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model ProjectMembership {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, projectId])
  @@map("project_memberships")
}

// --- Education Core (Session 04) ---------------------------------------
// Course -> Cohort -> Teacher(s) + Students
// Course -> Modules -> Lessons -> Resources
// See docs/EDUCATION_CORE.md for the full ownership/visibility model and
// the RLS policies in this migration's SQL.

model Course {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String       @default("")
  status      CourseStatus @default(draft)
  createdBy   String       @map("created_by") @db.Uuid
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator User     @relation("CourseCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cohorts Cohort[]
  modules Module[]
  lessons Lesson[]

  @@index([createdBy])
  @@map("courses")
}

model Cohort {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String       @map("course_id") @db.Uuid
  name      String
  status    CohortStatus @default(active)
  startsAt  DateTime?    @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime?    @map("ends_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course      Course          @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teachers    CohortTeacher[]
  enrollments Enrollment[]

  @@index([courseId])
  @@map("cohorts")
}

// Many-to-many: a cohort can have multiple teachers, a teacher can teach
// multiple cohorts. This — not a direct Course->Teacher link — is the
// ownership boundary every content-authorization check in src/lib/courses.ts
// walks: cohorts.course_id = <course> AND cohort_teachers.teacher_user_id = <actor>.
model CohortTeacher {
  cohortId      String   @map("cohort_id") @db.Uuid
  teacherUserId String   @map("teacher_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher User   @relation(fields: [teacherUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([cohortId, teacherUserId])
  @@index([teacherUserId])
  @@map("cohort_teachers")
}

model Enrollment {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId      String           @map("cohort_id") @db.Uuid
  studentUserId String           @map("student_user_id") @db.Uuid
  status        EnrollmentStatus @default(active)
  enrolledAt    DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(6)
  withdrawnAt   DateTime?        @map("withdrawn_at") @db.Timestamptz(6)

  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student User   @relation(fields: [studentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cohortId, studentUserId])
  @@index([studentUserId])
  @@map("enrollments")
}

model Module {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String        @map("course_id") @db.Uuid
  title       String
  order       Int
  status      ContentStatus @default(draft)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lessons Lesson[]

  @@index([courseId])
  @@map("modules")
}

// courseId is denormalized from module.courseId — immutable once set
// (lessons are never moved across courses in this foundation). This keeps
// every RLS ownership/visibility check a single join (lessons.course_id ->
// cohorts -> cohort_teachers/enrollments) instead of a three-table walk
// through modules on every policy.
model Lesson {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId    String        @map("module_id") @db.Uuid
  courseId    String        @map("course_id") @db.Uuid
  title       String
  content     String
  order       Int
  status      ContentStatus @default(draft)
  version     Int           @default(0)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  module    Module          @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course    Course          @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resources Resource[]
  versions  LessonVersion[]
  topics    LessonTopic[]

  @@index([moduleId])
  @@index([courseId])
  @@map("lessons")
}

// Content-versioning foundation: an immutable snapshot taken every time a
// lesson is published, so a later draft edit can never silently rewrite
// what an already-published/completed lesson said. Nothing reads these
// yet (no Progress/Attempt model exists to pin a student's completion to a
// specific version) — that's for Session 07/08 to consume; this session
// only guarantees the history is captured and never overwritten.
model LessonVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId    String   @map("lesson_id") @db.Uuid
  version     Int
  title       String
  content     String
  publishedBy String   @map("published_by") @db.Uuid
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publisher User   @relation(fields: [publishedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([lessonId, version])
  @@index([lessonId])
  @@map("lesson_versions")
}

// Deliberately an external URL, not a file upload — Session 01's handoff
// flagged that no storage/asset abstraction exists yet anywhere in the app.
// A real upload-backed Resource.type belongs to Session 13 (Files & Content);
// this is the minimal relationship the data model calls for today.
model Resource {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId  String       @map("lesson_id") @db.Uuid
  title     String
  url       String
  type      ResourceType @default(link)
  createdBy String       @map("created_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator User   @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([lessonId])
  @@map("resources")
}

// Subject -> Topic -> Subtopic/Skill, modeled as one self-referential
// hierarchy rather than three separate tables. Tags Lesson content today;
// Session 07 (Assessment) is expected to reuse this same table to tag
// Question rows rather than building a parallel taxonomy.
model Topic {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parent       Topic?        @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     Topic[]       @relation("TopicHierarchy")
  lessonTopics LessonTopic[]

  @@index([parentId])
  @@map("topics")
}

model LessonTopic {
  lessonId String @map("lesson_id") @db.Uuid
  topicId  String @map("topic_id") @db.Uuid

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([lessonId, topicId])
  @@index([topicId])
  @@map("lesson_topics")
}
